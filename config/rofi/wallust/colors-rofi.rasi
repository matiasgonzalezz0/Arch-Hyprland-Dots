* {
active-background: #FC97A7;
active-foreground: #FFFAE3;
normal-background: #040010;
normal-foreground: #FFFAE3;
urgent-background: #FEB6F8;
urgent-foreground: #FFFAE3;

alternate-active-background: #FDD7C4;
alternate-active-foreground: #FFFAE3;
alternate-normal-background: #040010;
alternate-normal-foreground: #FFFAE3;
alternate-urgent-background: #040010;
alternate-urgent-foreground: #FFFAE3;

selected-active-background: #FC97A7;
selected-active-foreground: #FFFAE3;
selected-normal-background: #F6EFCE;
selected-normal-foreground: #FFFAE3;
selected-urgent-background: #FEB6F8;
selected-urgent-foreground: #FFFAE3;

background-color: #040010;
background: rgba(0,0,0,0.7);
foreground: #F6EFCE;
border-color: #FC97A7;
}

