# Linked to ~/.ssh/config by link.sh. Only this file is tracked, keys stay in ~/.ssh.
#
# The agent is the ssh-agent.socket systemd user unit (SSH_AUTH_SOCK is set in .zshrc).
# A key is added to it the first time it is used, so its passphrase is asked once per login.

# Main account: git@github.com:<owner>/<repo>.git
Host github.com
	User git
	IdentityFile ~/.ssh/id_ed25519_git
	IdentitiesOnly yes

# Second account: git@github-488:<owner>/<repo>.git
Host github-488
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_ed25519_git488
	IdentitiesOnly yes

Host *
	AddKeysToAgent yes
